# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── MongoDB ─────────────────────────────────────────────────────────────────
# Local:   mongodb://127.0.0.1:27017/esomero
# Atlas:   mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/esomero
MONGO_URI=mongodb://127.0.0.1:27017/esomero

# ── JWT ─────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRE=24h

# ── Fine rate (USD per overdue day) ─────────────────────────────────────────
FINE_RATE=0.50

# ── Default loan period (days) ──────────────────────────────────────────────
LOAN_DAYS=14
